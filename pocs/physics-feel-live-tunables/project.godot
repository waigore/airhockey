; Engine PoC — physics feel with live tunables (issue #3). Not main-tree code.
; Engine: Godot 4.7.x / GDScript (ADR-0001).

config_version=5

[application]

config/name="PoC Physics Feel Live Tunables"
config/description="Engine PoC: puck/mallet collisions with live tunables (gravity 0)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[layer_names]

2d_physics/layer_1="table"
2d_physics/layer_2="puck"
2d_physics/layer_3="mallet"

[physics]

2d/default_gravity=0.0
2d/default_gravity_vector=Vector2(0, 0)

[rendering]

textures/canvas_textures/default_texture_filter=0
